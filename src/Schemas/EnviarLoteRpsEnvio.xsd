<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.abrasf.org.br/nfse.xsd"
           xmlns="http://www.abrasf.org.br/nfse.xsd"
           elementFormDefault="qualified">

    <xs:element name="EnviarLoteRpsEnvio">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="LoteRps" type="LoteRpsType"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="LoteRpsType">
        <xs:sequence>
            <xs:element name="NumeroLote" type="xs:string"/>
            <xs:element name="CpfCnpj" type="CpfCnpjType"/>
            <xs:element name="InscricaoMunicipal" type="xs:string"/>
            <xs:element name="QuantidadeRps" type="xs:int"/>
            <xs:element name="ListaRps" type="ListaRpsType"/>
        </xs:sequence>
        <xs:attribute name="Id" type="xs:string" use="required"/>
        <xs:attribute name="versao" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="ListaRpsType">
        <xs:sequence>
            <xs:element name="Rps" type="RpsType" maxOccurs="50"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="RpsType">
        <xs:sequence>
            <xs:element name="InfRps" type="InfDpsType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="InfDpsType">
        <xs:sequence>
            <xs:element name="IdentificacaoDps" type="IdentificacaoDpsType"/>
            <xs:element name="Competencia" type="xs:date"/>
            <xs:element name="NaturezaOperacao" type="xs:int"/>
            <xs:element name="Prestador" type="PrestadorType"/>
            <xs:element name="Tomador" type="TomadorType"/>
            <xs:element name="Servico" type="ServicoType"/>
        </xs:sequence>
        <xs:attribute name="Id" type="xs:string" use="required"/>
    </xs:complexType>

    <xs:complexType name="IdentificacaoDpsType">
        <xs:sequence>
            <xs:element name="Numero" type="xs:string"/>
            <xs:element name="Serie" type="xs:string"/>
            <xs:element name="Tipo" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PrestadorType">
        <xs:sequence>
            <xs:element name="CpfCnpj" type="CpfCnpjType"/>
            <xs:element name="InscricaoMunicipal" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="TomadorType">
        <xs:sequence>
            <xs:element name="CpfCnpj" type="CpfCnpjType"/>
            <xs:element name="RazaoSocial" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ServicoType">
        <xs:sequence>
            <xs:element name="Valores" type="ValoresType"/>
            <xs:element name="ItemListaServico" type="xs:string"/>
            <xs:element name="Discriminacao" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ValoresType">
        <xs:sequence>
            <xs:element name="ValorServicos" type="xs:decimal"/>
            <xs:element name="ValorIss" type="xs:decimal" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CpfCnpjType">
        <xs:choice>
            <xs:element name="Cpf" type="xs:string"/>
            <xs:element name="Cnpj" type="xs:string"/>
        </xs:choice>
    </xs:complexType>
</xs:schema>

