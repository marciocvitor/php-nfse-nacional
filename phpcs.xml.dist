<?xml version="1.0"?>
<ruleset name="php-nfse-nacional">
    <description>Padrão de código do projeto: PSR-12.</description>

    <file>src</file>
    <file>tests</file>
    <file>examples</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Avisos (ex.: linhas acima de 120 colunas) não reprovam a verificação; erros sim -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR12"/>
</ruleset>
