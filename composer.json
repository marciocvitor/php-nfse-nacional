{
    "name": "php-nfse/nfse-nacional",
    "description": "Biblioteca PHP para emissão de NFSe no Portal Nacional - Padrão ABRASF",
    "keywords": [
        "nfse",
        "nota fiscal",
        "nota fiscal de serviço",
        "portal nacional",
        "abrasf",
        "sped",
        "fiscal"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Comunidade PHP NFSe",
            "email": "contato@php-nfse.org",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-soap": "*",
        "ext-dom": "*",
        "ext-simplexml": "*",
        "ext-libxml": "*",
        "guzzlehttp/guzzle": "^7.0",
        "justinrainbow/json-schema": "^5.2",
        "robrichards/xmlseclibs": "^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "NFSeNacional\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NFSeNacional\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=PSR12 src/",
        "phpstan": "phpstan analyse src/ --level=5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
