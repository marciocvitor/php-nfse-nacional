{
    "name": "php-nfse/nfse-nacional",
    "description": "Biblioteca PHP para emissão de NFS-e no Portal Nacional, conforme NT 009 v1.01 (Reforma Tributária)",
    "keywords": [
        "nfse",
        "nota fiscal",
        "nota fiscal de serviço",
        "portal nacional",
        "reforma tributária",
        "ibs",
        "cbs",
        "fiscal"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Márcio Vitor",
            "email": "marcio.vitor@sisteminas.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-dom": "*",
        "ext-simplexml": "*",
        "ext-libxml": "*",
        "ext-zlib": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.0",
        "justinrainbow/json-schema": "^5.2",
        "robrichards/xmlseclibs": "^3.1",
        "tecnickcom/tcpdf": "^6.7",
        "mpdf/mpdf": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.13.6",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "NFSeNacional\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NFSeNacional\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
